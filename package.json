{
	"name": "bitcoin-block-stamp",
	"version": "1.3.3",
	"description": "Stamp your notes with the current Bitcoin block.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
