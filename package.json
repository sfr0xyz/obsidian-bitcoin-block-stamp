	"license": "MIT",
	"devDependencies": {
		"@types/node": "25.9.1",
		"esbuild": "0.28.1",
		"obsidian": "1.13.0",
		"tslib": "2.4.0",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	}
}
