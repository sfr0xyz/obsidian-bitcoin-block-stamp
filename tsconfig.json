{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "Node16",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "importHelpers": true,
    "isolatedModules": true,
	  "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES2018"
    ],
    "types": ["node"],
    "paths": {
      "main": ["./main.ts"],
      "@utils/*": ["./src/utils/*"],
      "@apis/*": ["./src/apis/*"],
      "@modals/*": ["./src/modals/*"],
      "@src/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts"
  ]
}
